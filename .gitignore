# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.vscode

# robot_controller: device-specific app config -- only the .example.yaml
# template is committed (same convention as modules/*/configs).
configs/robot_controller/*.yaml
!configs/robot_controller/*.example.yaml

# robot_controller: run logs
/logs/
*.log

# robot_controller: dev-tool output (snapshot_saver / detection_recorder
# default output_dir -- see configs/robot_controller/app.example.yaml)
/captures/
/detections/